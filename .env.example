# Copy to .env and use your own account. No credentials are included here.
CF_ACCOUNT_ID=
# Account-scoped custom token: Images Edit/Write AND Stream Edit/Write.
CF_API_TOKEN=
# Change this to your own unique workshop name. A random run suffix is added.
LAB_PREFIX=media-yourname
# Optional Images private-delivery extension: Hosted Images > Keys.
CF_IMAGES_SIGNING_KEY=
# Create a dedicated private R2 bucket in your dashboard first.
R2_BUCKET=
# Bucket-scoped Object Read & Write S3 credentials, not the bearer API token.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# default, eu, us, or fedramp; must match your bucket's jurisdiction.
R2_JURISDICTION=default
